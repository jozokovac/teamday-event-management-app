{
  "name": "event-management-app",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun run start",
    "build": "vite build && tsc -p tsconfig.server.json --noEmit",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview",
    "dev:local": "concurrently -n fe,be -c cyan,yellow \"vite\" \"tsx watch server/index.ts\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^8.2.2"
  }
}
